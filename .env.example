# ====================================================================
# Configurações do Servidor
# ====================================================================
HOST=0.0.0.0
PORT=8000

# ====================================================================
# Autenticação de Acesso ao Serviço
# ====================================================================
AUTH_USERNAME=admin
AUTH_PASSWORD=rural2026!
SESSION_SECRET_KEY=uma_chave_longa_e_aleatoria_para_assinatura_de_cookies

# ====================================================================
# Banco de Dados
# ====================================================================
# Deixe vazio para usar um SQLite local (rural.db) em desenvolvimento.
# Banco definitivo: PostgreSQL no Neon (crie as tabelas com db/schema.sql e db/seed.sql).
# Cole a connection string do painel do Neon (o driver psycopg 3 já está no requirements):
#   postgresql://usuario:senha@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require
# Outros bancos (instale o driver correspondente):
#   MySQL:      mysql+pymysql://usuario:senha@host:3306/banco        (pip install pymysql)
#   SQL Server: mssql+pyodbc://usuario:senha@host/banco?driver=ODBC+Driver+18+for+SQL+Server
DATABASE_URL=

# ====================================================================
# Google Gemini API (Opcional no servidor)
# ====================================================================
# A chave agora é informada dinamicamente pelo usuário no navegador
# (mantida apenas em sessionStorage e nunca gravada no servidor).
# O campo abaixo atua apenas como fallback opcional para desenvolvimento local.
GEMINI_API_KEY=

# ====================================================================
# Versão e Avaliação (Commit no GitHub)
# ====================================================================
# Hash curto ou completo do commit para exibição no rodapé da página principal:
GITHUB_COMMIT_HASH=
# (Opcional) URL base do repositório no GitHub:
GITHUB_REPO_URL=https://github.com/joaorv/Sistema-financeiro-rural
